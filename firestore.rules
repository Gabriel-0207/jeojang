rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Primitives
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // 3. Entity Validation Blueprints
    function isValidUserAccount(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'photoURL', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'createdAt', 'updatedAt'])
        && data.uid is string
        && data.uid == request.auth.uid
        && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.displayName is string && data.displayName.size() <= 100
        && data.photoURL is string && data.photoURL.size() <= 500
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStatsMap(stats) {
      return stats is map
        && stats.keys().hasAll(['academics', 'fitness', 'social', 'leadership', 'creativity', 'mental'])
        && stats.keys().hasOnly(['academics', 'fitness', 'social', 'leadership', 'creativity', 'mental'])
        && stats.academics is int && stats.academics >= 10 && stats.academics <= 100
        && stats.fitness is int && stats.fitness >= 10 && stats.fitness <= 100
        && stats.social is int && stats.social >= 10 && stats.social <= 100
        && stats.leadership is int && stats.leadership >= 10 && stats.leadership <= 100
        && stats.creativity is int && stats.creativity >= 10 && stats.creativity <= 100
        && stats.mental is int && stats.mental >= 10 && stats.mental <= 100;
    }

    function isValidGradeForScore(grade, totalScore) {
      return grade is string && grade.size() == 1 && (
        (grade == 'E' && totalScore >= 60 && totalScore < 144) ||
        (grade == 'D' && totalScore >= 144 && totalScore < 300) ||
        (grade == 'C' && totalScore >= 300 && totalScore < 540) ||
        (grade == 'B' && totalScore >= 540 && totalScore < 840) ||
        (grade == 'A' && totalScore >= 840 && totalScore < 1200) ||
        (grade == 'S' && totalScore >= 1200)
      );
    }

    function isValidBoundedIdList(arr, maxLen) {
      return arr is list
        && arr.size() <= maxLen
        && (arr.size() == 0 || (arr[0] is string && arr[0].size() >= 1 && arr[0].size() <= 40));
    }

    function existingPoints(ex) {
      return 'points' in ex ? ex.points : 0;
    }

    function isValidStudentProfile(data) {
      return data.keys().hasAll([
          'uid', 'studentNumber', 'name', 'grade', 'totalScore', 'completedCount',
          'points', 'stats', 'dailyKey', 'dailyCompleted', 'weeklyKey', 'weeklyCompleted',
          'monthlyKey', 'monthlyCompleted', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'studentNumber', 'name', 'grade', 'totalScore', 'completedCount',
          'points', 'stats', 'dailyKey', 'dailyCompleted', 'weeklyKey', 'weeklyCompleted',
          'monthlyKey', 'monthlyCompleted', 'createdAt', 'updatedAt'
        ])
        && data.uid is string
        && data.uid == request.auth.uid
        && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.studentNumber is string
        && data.studentNumber.size() >= 2 && data.studentNumber.size() <= 20
        && data.studentNumber.matches('^[0-9A-Za-z가-힣\\-\\s]{2,20}$')
        && data.name is string
        && data.name.size() >= 1 && data.name.size() <= 30
        && data.totalScore is int && data.totalScore >= 60 && data.totalScore <= 59994
        && data.completedCount is int && data.completedCount >= 0 && data.completedCount <= 100000
        && data.points is int && data.points >= 0 && data.points <= 1000000
        && isValidStatsMap(data.stats)
        && data.totalScore >= (
          data.stats.academics + data.stats.fitness + data.stats.social +
          data.stats.leadership + data.stats.creativity + data.stats.mental
        )
        && isValidGradeForScore(data.grade, data.totalScore)
        && data.dailyKey is string && data.dailyKey.size() == 10
        && data.dailyKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && isValidBoundedIdList(data.dailyCompleted, 12)
        && data.weeklyKey is string && data.weeklyKey.size() == 8
        && data.weeklyKey.matches('^[0-9]{4}-W[0-9]{2}$')
        && isValidBoundedIdList(data.weeklyCompleted, 6)
        && data.monthlyKey is string && data.monthlyKey.size() == 7
        && data.monthlyKey.matches('^[0-9]{4}-[0-9]{2}$')
        && isValidBoundedIdList(data.monthlyCompleted, 3)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isInitialStudentState(data) {
      return data.grade == 'E'
        && data.totalScore == 60
        && data.completedCount == 0
        && data.points == 0
        && data.stats.academics == 10
        && data.stats.fitness == 10
        && data.stats.social == 10
        && data.stats.leadership == 10
        && data.stats.creativity == 10
        && data.stats.mental == 10
        && data.dailyCompleted.size() == 0
        && data.weeklyCompleted.size() == 0
        && data.monthlyCompleted.size() == 0;
    }

    function isValidMissionLog(data) {
      return data.keys().hasAll([
          'uid', 'missionId', 'missionTitle', 'period', 'periodKey',
          'totalGain', 'note', 'createdAt'
        ])
        && data.keys().hasOnly([
          'uid', 'missionId', 'missionTitle', 'period', 'periodKey',
          'totalGain', 'note', 'createdAt'
        ])
        && data.uid is string
        && data.uid == request.auth.uid
        && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.missionId is string
        && data.missionId.size() >= 1 && data.missionId.size() <= 40
        && data.missionId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.missionTitle is string
        && data.missionTitle.size() >= 1 && data.missionTitle.size() <= 100
        && data.period is string && data.period in ['daily', 'weekly', 'monthly']
        && data.periodKey is string && data.periodKey.size() >= 4 && data.periodKey.size() <= 16
        && data.totalGain is int && data.totalGain >= 1 && data.totalGain <= 100
        && data.note is string && data.note.size() <= 150
        && data.createdAt is timestamp;
    }

    function isValidStudySubject(subject) {
      return subject is string
        && subject.size() >= 1 && subject.size() <= 20
        && subject in ['국어', '수학', '영어', '한국사/사회', '과학', '기타'];
    }

    function isValidStudyLog(data) {
      return data.keys().hasAll(['uid', 'subject', 'topic', 'minutes', 'dateKey', 'createdAt'])
        && data.keys().hasOnly(['uid', 'subject', 'topic', 'minutes', 'dateKey', 'createdAt'])
        && data.uid is string && data.uid == request.auth.uid
        && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && isValidStudySubject(data.subject)
        && data.topic is string && data.topic.size() >= 1 && data.topic.size() <= 100
        && data.minutes is int && data.minutes >= 1 && data.minutes <= 300
        && data.dateKey is string && data.dateKey.size() == 10
        && data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.createdAt is timestamp;
    }

    function isValidStudyTask(data) {
      return data.keys().hasAll(['uid', 'subject', 'title', 'completed', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'subject', 'title', 'completed', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == request.auth.uid
        && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && isValidStudySubject(data.subject)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 100
        && data.completed is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStudyNote(data) {
      return data.keys().hasAll(['uid', 'subject', 'title', 'content', 'reviewed', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'subject', 'title', 'content', 'reviewed', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == request.auth.uid
        && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && isValidStudySubject(data.subject)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 80
        && data.content is string && data.content.size() >= 1 && data.content.size() <= 500
        && data.reviewed is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSkinId(skinId) {
      return skinId is string && skinId.size() <= 24 && skinId in [
        'novice_uniform',
        'track_runner',
        'arcane_scholar',
        'crimson_knight',
        'emerald_archer',
        'valkyrie_gold',
        'royal_paladin',
        'celestial_lord'
      ];
    }

    function isValidOwnedSkins(arr) {
      return arr is list
        && arr.size() >= 1 && arr.size() <= 16
        && arr[0] is string && arr[0] == 'novice_uniform';
    }

    function isValidStudentCharacter(data) {
      return data.keys().hasAll([
          'uid', 'nickname', 'motto', 'skinTone', 'hairStyle', 'hairColor',
          'eyeStyle', 'equippedSkin', 'ownedSkins', 'locked', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'nickname', 'motto', 'skinTone', 'hairStyle', 'hairColor',
          'eyeStyle', 'equippedSkin', 'ownedSkins', 'locked', 'createdAt', 'updatedAt'
        ])
        && data.uid is string && data.uid == request.auth.uid
        && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.nickname is string && data.nickname.size() >= 1 && data.nickname.size() <= 24
        && data.motto is string && data.motto.size() <= 60
        && data.skinTone is string && data.skinTone.size() <= 16
        && data.skinTone in ['fair', 'warm', 'tan', 'deep']
        && data.hairStyle is string && data.hairStyle.size() <= 24
        && data.hairStyle in ['short_neat', 'two_block', 'parted_curtain', 'wavy_bob', 'long_straight', 'ponytail']
        && data.hairColor is string && data.hairColor.size() <= 20
        && data.hairColor in [
          'black', 'dark_brown', 'chestnut', 'blonde', 'crimson_red',
          'navy_tint', 'emerald_tint', 'violet_plum', 'ash_gray', 'platinum'
        ]
        && data.eyeStyle is string && data.eyeStyle.size() <= 16
        && data.eyeStyle in [
          'bright', 'calm', 'smile', 'focused', 'wink',
          'amber_orange', 'rose_pink', 'teal_mint', 'silver_ice', 'obsidian_dark'
        ]
        && isValidSkinId(data.equippedSkin)
        && isValidOwnedSkins(data.ownedSkins)
        && data.equippedSkin in data.ownedSkins
        && data.locked is bool && data.locked == true
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // 4. Collection Rules
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserAccount(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserAccount(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'photoURL', 'updatedAt']);
      allow delete: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && !existsAfter(/databases/$(database)/documents/students/$(userId));
    }

    match /students/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidStudentProfile(incoming())
        && isInitialStudentState(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidStudentProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            // Action 1: Update student number or name
            incoming().diff(existing()).affectedKeys().hasOnly(['studentNumber', 'name', 'updatedAt'])
          ) || (
            // Action 2: Complete mission & advance stats/grade/points
            incoming().diff(existing()).affectedKeys().hasOnly([
              'grade', 'totalScore', 'completedCount', 'points', 'stats',
              'dailyKey', 'dailyCompleted', 'weeklyKey', 'weeklyCompleted',
              'monthlyKey', 'monthlyCompleted', 'updatedAt'
            ])
            && incoming().completedCount == existing().completedCount + 1
            && incoming().totalScore > existing().totalScore
            && incoming().totalScore <= existing().totalScore + 50
            && incoming().points > existingPoints(existing())
            && incoming().points <= existingPoints(existing()) + 400
            && incoming().stats.academics >= existing().stats.academics
            && incoming().stats.fitness >= existing().stats.fitness
            && incoming().stats.social >= existing().stats.social
            && incoming().stats.leadership >= existing().stats.leadership
            && incoming().stats.creativity >= existing().stats.creativity
            && incoming().stats.mental >= existing().stats.mental
          ) || (
            // Action 3: Reset progress back to initial E-rank state
            isInitialStudentState(incoming())
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'grade', 'totalScore', 'completedCount', 'points', 'stats',
              'dailyKey', 'dailyCompleted', 'weeklyKey', 'weeklyCompleted',
              'monthlyKey', 'monthlyCompleted', 'updatedAt'
            ])
          ) || (
            // Action 4: Spend points to unlock a character skin atomically
            incoming().diff(existing()).affectedKeys().hasOnly(['points', 'updatedAt'])
            && incoming().points < existingPoints(existing())
            && incoming().points >= 0
            && existsAfter(/databases/$(database)/documents/students/$(userId)/character/main)
            && getAfter(/databases/$(database)/documents/students/$(userId)/character/main).data.ownedSkins.size() == get(/databases/$(database)/documents/students/$(userId)/character/main).data.ownedSkins.size() + 1
          )
        );
      allow delete: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId);

      match /logs/{logId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(logId);
        allow list: if isOwner(userId) && isValidId(userId) && resource.data.uid == request.auth.uid;
        allow create: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(logId)
          && isOwner(userId)
          && isValidMissionLog(incoming())
          && incoming().createdAt == request.time
          && existsAfter(/databases/$(database)/documents/students/$(userId))
          && getAfter(/databases/$(database)/documents/students/$(userId)).data.uid == request.auth.uid;
        allow update: if false;
        allow delete: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(logId)
          && isOwner(userId)
          && resource.data.uid == request.auth.uid;
      }

      match /studyLogs/{logId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(logId);
        allow list: if isOwner(userId) && isValidId(userId) && resource.data.uid == request.auth.uid;
        allow create: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(logId)
          && isOwner(userId)
          && isValidStudyLog(incoming())
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/students/$(userId))
          && get(/databases/$(database)/documents/students/$(userId)).data.uid == request.auth.uid;
        allow update: if false;
        allow delete: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(logId)
          && isOwner(userId)
          && resource.data.uid == request.auth.uid;
      }

      match /studyTasks/{taskId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(taskId);
        allow list: if isOwner(userId) && isValidId(userId) && resource.data.uid == request.auth.uid;
        allow create: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(taskId)
          && isOwner(userId)
          && isValidStudyTask(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/students/$(userId))
          && get(/databases/$(database)/documents/students/$(userId)).data.uid == request.auth.uid;
        allow update: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(taskId)
          && isOwner(userId)
          && isValidStudyTask(incoming())
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['completed', 'title', 'subject', 'updatedAt']);
        allow delete: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(taskId)
          && isOwner(userId)
          && resource.data.uid == request.auth.uid;
      }

      match /studyNotes/{noteId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(noteId);
        allow list: if isOwner(userId) && isValidId(userId) && resource.data.uid == request.auth.uid;
        allow create: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(noteId)
          && isOwner(userId)
          && isValidStudyNote(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/students/$(userId))
          && get(/databases/$(database)/documents/students/$(userId)).data.uid == request.auth.uid;
        allow update: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(noteId)
          && isOwner(userId)
          && isValidStudyNote(incoming())
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['reviewed', 'title', 'content', 'subject', 'updatedAt']);
        allow delete: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(noteId)
          && isOwner(userId)
          && resource.data.uid == request.auth.uid;
      }

      match /character/{docId} {
        allow get: if isOwner(userId) && isValidId(userId) && docId == 'main';
        allow create: if isVerifiedUser()
          && isValidId(userId)
          && docId == 'main'
          && isOwner(userId)
          && isValidStudentCharacter(incoming())
          && incoming().ownedSkins.size() == 1
          && incoming().equippedSkin == 'novice_uniform'
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && existsAfter(/databases/$(database)/documents/students/$(userId))
          && getAfter(/databases/$(database)/documents/students/$(userId)).data.uid == request.auth.uid;
        allow update: if isVerifiedUser()
          && isValidId(userId)
          && docId == 'main'
          && isOwner(userId)
          && isValidStudentCharacter(incoming())
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            (
              // Legacy migration if an unlocked pre-RPG character document existed
              !('locked' in existing())
              && incoming().locked == true
              && incoming().ownedSkins.size() == 1
              && incoming().equippedSkin == 'novice_uniform'
            ) || (
              // Base character is permanently locked: only equip an already-owned skin
              existing().locked == true
              && incoming().diff(existing()).affectedKeys().hasOnly(['equippedSkin', 'updatedAt'])
              && incoming().equippedSkin in existing().ownedSkins
            ) || (
              // Base character is permanently locked: atomically purchase & equip a new skin with points
              existing().locked == true
              && incoming().diff(existing()).affectedKeys().hasOnly(['ownedSkins', 'equippedSkin', 'updatedAt'])
              && incoming().ownedSkins.size() == existing().ownedSkins.size() + 1
              && incoming().ownedSkins.hasAll(existing().ownedSkins)
              && incoming().equippedSkin in incoming().ownedSkins
              && existsAfter(/databases/$(database)/documents/students/$(userId))
              && getAfter(/databases/$(database)/documents/students/$(userId)).data.points < existingPoints(get(/databases/$(database)/documents/students/$(userId)).data)
            )
          );
        allow delete: if isVerifiedUser()
          && isValidId(userId)
          && docId == 'main'
          && isOwner(userId)
          && !existsAfter(/databases/$(database)/documents/students/$(userId));
      }
    }
  }
}
