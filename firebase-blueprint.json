{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "Private Google account PII for an authenticated student.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 200
        },
        "displayName": {
          "type": "string",
          "maxLength": 100
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "displayName", "photoURL", "createdAt", "updatedAt"]
    },
    "StudentStats": {
      "title": "StudentStats",
      "description": "Six core life stats for a Mokpo Deokin High School student.",
      "type": "object",
      "properties": {
        "academics": { "type": "integer" },
        "fitness": { "type": "integer" },
        "social": { "type": "integer" },
        "leadership": { "type": "integer" },
        "creativity": { "type": "integer" },
        "mental": { "type": "integer" }
      },
      "required": ["academics", "fitness", "social", "leadership", "creativity", "mental"]
    },
    "StudentProfile": {
      "title": "StudentProfile",
      "description": "Student profile, rank starting at E, six stats, and current mission period completions.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "studentNumber": {
          "type": "string",
          "minLength": 2,
          "maxLength": 20,
          "pattern": "^[0-9A-Za-z가-힣\\-\\s]{2,20}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "grade": {
          "type": "string",
          "enum": ["E", "D", "C", "B", "A", "S"],
          "maxLength": 2
        },
        "totalScore": {
          "type": "integer"
        },
        "completedCount": {
          "type": "integer"
        },
        "stats": {
          "$ref": "#/entities/StudentStats"
        },
        "dailyKey": {
          "type": "string",
          "maxLength": 16,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "dailyCompleted": {
          "type": "array"
        },
        "weeklyKey": {
          "type": "string",
          "maxLength": 16,
          "pattern": "^[0-9]{4}-W[0-9]{2}$"
        },
        "weeklyCompleted": {
          "type": "array"
        },
        "monthlyKey": {
          "type": "string",
          "maxLength": 16,
          "pattern": "^[0-9]{4}-[0-9]{2}$"
        },
        "monthlyCompleted": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "studentNumber",
        "name",
        "grade",
        "totalScore",
        "completedCount",
        "stats",
        "dailyKey",
        "dailyCompleted",
        "weeklyKey",
        "weeklyCompleted",
        "monthlyKey",
        "monthlyCompleted",
        "createdAt",
        "updatedAt"
      ]
    },
    "MissionLog": {
      "title": "MissionLog",
      "description": "Immutable activity log entry for a completed daily, weekly, or monthly mission.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "missionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "missionTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "period": {
          "type": "string",
          "enum": ["daily", "weekly", "monthly"],
          "maxLength": 10
        },
        "periodKey": {
          "type": "string",
          "minLength": 4,
          "maxLength": 16
        },
        "totalGain": {
          "type": "integer"
        },
        "note": {
          "type": "string",
          "maxLength": 150
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "missionId",
        "missionTitle",
        "period",
        "periodKey",
        "totalGain",
        "note",
        "createdAt"
      ]
    },
    "StudyLog": {
      "title": "StudyLog",
      "description": "Focused study timer session recorded in the academic support workspace.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "subject": {
          "type": "string",
          "enum": ["국어", "수학", "영어", "한국사/사회", "과학", "기타"],
          "maxLength": 20
        },
        "topic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "minutes": {
          "type": "integer"
        },
        "dateKey": {
          "type": "string",
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "subject", "topic", "minutes", "dateKey", "createdAt"]
    },
    "StudyTask": {
      "title": "StudyTask",
      "description": "Subject-specific academic study goal or checklist item.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "subject": {
          "type": "string",
          "enum": ["국어", "수학", "영어", "한국사/사회", "과학", "기타"],
          "maxLength": 20
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "completed": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "subject", "title", "completed", "createdAt", "updatedAt"]
    },
    "StudyNote": {
      "title": "StudyNote",
      "description": "Wrong-answer or core concept review note for exam preparation.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "subject": {
          "type": "string",
          "enum": ["국어", "수학", "영어", "한국사/사회", "과학", "기타"],
          "maxLength": 20
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "reviewed": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "subject", "title", "content", "reviewed", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserAccount" },
      "description": "Private Google account PII isolated per authenticated user."
    },
    "/students/{userId}": {
      "schema": { "$ref": "#/entities/StudentProfile" },
      "description": "Student life-stat profile, initial E rank, 6 core stats, and period completions."
    },
    "/students/{userId}/logs/{logId}": {
      "schema": { "$ref": "#/entities/MissionLog" },
      "description": "Mission completion history subcollection owned by the student."
    },
    "/students/{userId}/studyLogs/{logId}": {
      "schema": { "$ref": "#/entities/StudyLog" },
      "description": "Academic focus timer sessions owned by the student."
    },
    "/students/{userId}/studyTasks/{taskId}": {
      "schema": { "$ref": "#/entities/StudyTask" },
      "description": "Subject study goal checklist items owned by the student."
    },
    "/students/{userId}/studyNotes/{noteId}": {
      "schema": { "$ref": "#/entities/StudyNote" },
      "description": "Exam review and wrong-answer notes owned by the student."
    }
  }
}
